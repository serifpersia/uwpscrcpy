<Page
    x:Class="uwpscrcpy.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Default"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>

        <!-- ==================== -->
        <!-- Text Colors -->
        <!-- ==================== -->
        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="{ThemeResource SystemBaseMediumColor}" />
        <SolidColorBrush x:Key="DisabledTextBrush"
                         Color="{ThemeResource SystemBaseLowColor}" />

        <!-- ==================== -->
        <!-- Backgrounds -->
        <!-- ==================== -->
        <SolidColorBrush x:Key="PageBackgroundBrush"
                         Color="{ThemeResource SystemAltHighColor}" />
        <SolidColorBrush x:Key="PaneBackgroundBrush"
                         Color="{ThemeResource SystemChromeLowColor}" />
        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="{ThemeResource SystemChromeMediumLowColor}" />

        <!-- ==================== -->
        <!-- Borders / Dividers -->
        <!-- ==================== -->
        <SolidColorBrush x:Key="DividerBrush"
                         Color="{ThemeResource SystemChromeLowColor}" />

        <!-- ==================== -->
        <!-- Video Player Always Black -->
        <!-- ==================== -->
        <SolidColorBrush x:Key="VideoPlayerBackgroundBrush" Color="Black" />

    </Page.Resources>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource PageBackgroundBrush}">

        <SplitView x:Name="MainSplitView"
                   DisplayMode="Overlay"
                   OpenPaneLength="320"
                   IsPaneOpen="True"
                   PanePlacement="Right"
                   PaneBackground="{ThemeResource PaneBackgroundBrush}">

            <!-- ========== -->
            <!-- Side pane -->
            <!-- ========== -->
            <SplitView.Pane>
                <Border Padding="24"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="1,0,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Connection"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}"
                                       Margin="0,0,0,16"/>

                            <ToggleButton x:Name="ConnectToggle"
                                          Height="44"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Content="Start"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,16"
                                          Click="ConnectToggle_Click"/>

                            <ToggleSwitch x:Name="ControlsOnlyToggle"
                                          Header="Controls Only Mode"
                                          IsOn="False"
                                          Foreground="{ThemeResource PrimaryTextBrush}"
                                          Margin="0,0,0,16"
                                          Toggled="ControlsOnlyToggle_Toggled"/>

                            <ToggleSwitch x:Name="UhidMouseToggle"
                                          Header="Enable Mouse (UHID)"
                                          IsOn="False"
                                          IsEnabled="False"
                                          Foreground="{ThemeResource PrimaryTextBrush}"
                                          Margin="0,-8,0,0"
                                          ToolTipService.ToolTip="Shows a visible mouse cursor on the device. Only for Controls Only mode."
                                          Toggled="UhidMouseToggle_Toggled"/>

                            <ToggleSwitch x:Name="InvertScrollToggle"
                                          Header="Invert Scroll Direction"
                                          IsOn="False"
                                          IsEnabled="False"
                                          Foreground="{ThemeResource DisabledTextBrush}"
                                          FontSize="12"
                                          Margin="0,-4,0,16"/>

                            <Button x:Name="FullScreenButton"
                                    Content="Fullscreen"
                                    Height="42"
                                    FontSize="15"
                                    HorizontalAlignment="Stretch"
                                    Click="FullScreenButton_Click"/>

                            <Button Content="Close Menu"
                                    Margin="0,10,0,0"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    Click="HamburgerButton_Click"/>

                            <TextBlock Text="IP Address"
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,16,0,4"/>
                            <TextBox x:Name="IpAddressBox"
                                     Height="36"
                                     Text="192.168.1.8"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Port"
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="PortBox"
                                     Height="36"
                                     Text="5555"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Max Height"
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="maxSizeBox"
                                     Height="36"
                                     Text="720"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Bitrate (Mbps)"
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="BitRateBox"
                                     Height="36"
                                     Text="4"
                                     Margin="0,0,0,12"/>

                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerBrush}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Logs"
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,16,0,4"/>
                            <ScrollViewer Height="150"
                                          Background="{ThemeResource SurfaceBrush}"
                                          Padding="5">
                                <TextBlock x:Name="LogBlock"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </ScrollViewer>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>

            <!-- ========== -->
            <!-- Main view -->
            <!-- ========== -->
            <SplitView.Content>
                <Grid x:Name="ContentGrid"
                      Background="{ThemeResource PageBackgroundBrush}">

                    <!-- Video player always black -->
                    <Grid x:Name="VideoContainer"
                          Background="{ThemeResource VideoPlayerBackgroundBrush}">
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="VideoSurface"
                                  Background="Black"
                                  PointerPressed="VideoSurface_PointerPressed"
                                  PointerMoved="VideoSurface_PointerMoved"
                                  PointerReleased="VideoSurface_PointerReleased"
                                  PointerCanceled="VideoSurface_PointerReleased"
                                  PointerExited="VideoSurface_PointerReleased"
                                  PointerWheelChanged="VideoSurface_PointerWheelChanged"/>
                        </Viewbox>
                    </Grid>

                    <!-- Mouse/touchpad: always dark, fixed colors -->
                    <Grid x:Name="MouseControlContainer"
                          Background="Black"
                          Visibility="Collapsed">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <!-- Touchpad area -->
                        <Grid x:Name="MousePadArea"
                              Grid.Row="0"
                              Background="#111111"
                              PointerPressed="MousePadArea_PointerPressed"
                              PointerMoved="MousePadArea_PointerMoved"
                              PointerReleased="MousePadArea_PointerReleased"
                              PointerCanceled="MousePadArea_PointerReleased"
                              PointerExited="MousePadArea_PointerReleased"/>

                        <!-- Buttons -->
                        <Grid Grid.Row="1"
                              Background="#000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="LeftClickArea"
                                    Grid.Column="0"
                                    Background="#222222"
                                    BorderBrush="#333333"
                                    BorderThickness="0,1,1,0"
                                    PointerPressed="LeftClickArea_PointerPressed"
                                    PointerReleased="LeftClickArea_PointerReleased"/>

                            <Border x:Name="RightClickArea"
                                    Grid.Column="1"
                                    Background="#222222"
                                    BorderBrush="#333333"
                                    BorderThickness="0,1,0,0"
                                    PointerPressed="RightClickArea_PointerPressed"
                                    PointerReleased="RightClickArea_PointerReleased"/>
                        </Grid>
                    </Grid>

                    <!-- Hamburger button -->
                    <StackPanel VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Margin="0,10,10,0">

                        <Button x:Name="HamburgerButton"
                                Width="48"
                                Height="48"
                                BorderThickness="0"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                Click="HamburgerButton_Click">

                            <FontIcon Glyph="&#xE700;"
                                      FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </SplitView.Content>

        </SplitView>
    </Grid>
</Page>
