<Page
    x:Class="uwpscrcpy.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#121212"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Black">

        <SplitView x:Name="MainSplitView"
                   DisplayMode="Overlay"
                   OpenPaneLength="320"
                   IsPaneOpen="True"
                   PanePlacement="Right" 
                   PaneBackground="#1E1E1E">

            <SplitView.Pane>
                <Border Padding="24" BorderBrush="#2C2C2C" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Connection" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <ToggleButton x:Name="ConnectToggle"
                                              Height="44"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              Content="Start"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,0,0,16"
                                              Click="ConnectToggle_Click"/>

                                <Button x:Name="FullScreenButton" Content="Fullscreen" Height="42" FontSize="15" HorizontalAlignment="Stretch" Click="FullScreenButton_Click"/>

                                <Button Grid.Row="1" Content="Close Menu" Margin="0,10,0,0" Height="42" HorizontalAlignment="Stretch" Click="HamburgerButton_Click"/>

                                <TextBlock Text="IP Address" Foreground="#BBBBBB" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="IpAddressBox" Height="36" Text="192.168.1.8" Margin="0,0,0,12"/>

                                <TextBlock Text="Port" Foreground="#BBBBBB" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="PortBox" Height="36" Text="5555" Margin="0,0,0,12"/>

                                <TextBlock Text="Max Height" Foreground="#BBBBBB" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="maxSizeBox" Height="36" Text="720" Margin="0,0,0,12"/>


                                <TextBlock Text="Bitrate (Mbps)" Foreground="#BBBBBB" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox x:Name="BitRateBox" Height="36" Text="4" Margin="0,0,0,12"/>


                                <Rectangle Height="1" Fill="#2C2C2C" Margin="0,0,0,16"/>

                                <TextBlock Text="Logs" Foreground="#BBBBBB" FontSize="13" Margin="0,16,0,4"/>
                                <ScrollViewer Height="150" Background="#111" Padding="5">
                                    <TextBlock x:Name="LogBlock" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid x:Name="ContentGrid" Background="Black">

                    <Grid x:Name="VideoContainer" Background="Black">
                        
                        <Viewbox Stretch="Uniform">

                            <Grid x:Name="VideoSurface"
                                  Background="Transparent"
                                  PointerPressed="VideoSurface_PointerPressed"
                                  PointerMoved="VideoSurface_PointerMoved"
                                  PointerReleased="VideoSurface_PointerReleased"
                                  PointerCanceled="VideoSurface_PointerReleased"
                                  PointerExited="VideoSurface_PointerReleased">
                            </Grid>
                        </Viewbox>
                    </Grid>

                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,10,0">
                        <Button x:Name="HamburgerButton"
                            Background="#99000000"
                            Foreground="White"
                            BorderThickness="0"
                            Width="48" Height="48"
                            Click="HamburgerButton_Click">
                            <Button.Content>
                                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>

                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>