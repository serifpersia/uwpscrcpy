<Page
    x:Class="uwpscrcpy.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Default"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemBaseMediumColor}" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="{ThemeResource SystemBaseLowColor}" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemAltHighColor}" />
        <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource SystemChromeLowColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemChromeMediumLowColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemChromeLowColor}" />
        <SolidColorBrush x:Key="VideoPlayerBackgroundBrush" Color="Black" />
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}">
        <SplitView x:Name="MainSplitView"
                   DisplayMode="Overlay"
                   OpenPaneLength="320"
                   IsPaneOpen="True"
                   PanePlacement="Right"
                   PaneBackground="{ThemeResource PaneBackgroundBrush}">

            <SplitView.Pane>
                <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel>
                            <TextBlock Text="UWP Scrcpy" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,24"/>

                            <Border Background="{ThemeResource SurfaceBrush}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <ToggleButton x:Name="ConnectToggle" Height="40" Content="Start" HorizontalAlignment="Stretch" Click="ConnectToggle_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource SurfaceBrush}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Device Settings" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="IP Address" Grid.Row="0" Margin="0,0,12,0" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBox x:Name="IpAddressBox" Grid.Row="0" Grid.Column="1" Text="192.168.1.14"/>
                                        <TextBlock Text="Port" Grid.Row="1" Margin="0,0,12,0" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Text="5555"/>
                                        <TextBlock Text="Max Height" Grid.Row="2" Margin="0,0,12,0" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBox x:Name="MaxSizeBox" Grid.Row="2" Grid.Column="1" Text="720"/>
                                        <TextBlock Text="Max FPS" Grid.Row="3" Margin="0,0,12,0" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBox x:Name="MaxFpsBox" Grid.Row="3" Grid.Column="1" Text="30"/>
                                        <TextBlock Text="Bitrate (Mbps)" Grid.Row="4" Margin="0,0,12,0" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBox x:Name="BitRateBox" Grid.Row="4" Grid.Column="1" Text="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource SurfaceBrush}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ToggleSwitch x:Name="ControlsOnlyToggle" 
                                                  Header="Controls Only Mode (UHID)" 
                                                  IsOn="False" 
                                                  Toggled="ControlsOnlyToggle_Toggled"/>
                                    <ToggleSwitch x:Name="InvertScrollToggle" 
                                                  Header="Invert Scroll Direction" 
                                                  IsOn="False" 
                                                  IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="VolumeControlPanel"
                                    Background="{ThemeResource SurfaceBrush}"
                                    Padding="16"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Volume"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <Slider x:Name="VolumeSlider"
                                            Minimum="0"
                                            Maximum="15"
                                            Value="0"
                                            PointerCaptureLost="VolumeSlider_PointerCaptureLost"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="FullScreenButton" Content="Fullscreen" Height="40" HorizontalAlignment="Stretch" Click="FullScreenButton_Click" Margin="0,0,0,8"/>
                            <Button Content="Close Menu" Height="40" HorizontalAlignment="Stretch" Click="HamburgerButton_Click"/>

                            <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="0,24,0,16"/>
                            <TextBlock Text="Logs" Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="LogBlock" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" Background="{ThemeResource SurfaceBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid x:Name="ContentGrid" Background="{ThemeResource PageBackgroundBrush}">
                    <Grid x:Name="VideoContainer" Background="{ThemeResource VideoPlayerBackgroundBrush}">
                        <Viewbox Stretch="Uniform">
                            <SwapChainPanel x:Name="VideoPanel">
                                <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </SwapChainPanel>
                        </Viewbox>
                    </Grid>

                    <Grid x:Name="MouseControlContainer" Background="Black" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="MousePadArea" Grid.Row="0" Background="#111111"/>
                        <Grid Grid.Row="1" Background="#000000">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LeftClickArea" Grid.Column="0" Background="#222222" BorderBrush="#333333" BorderThickness="0,1,1,0"/>
                            <Border x:Name="RightClickArea" Grid.Column="1" Background="#222222" BorderBrush="#333333" BorderThickness="0,1,0,0"/>
                        </Grid>
                    </Grid>

                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,12,0">
                        <Button x:Name="HamburgerButton" Width="44" Height="44" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Foreground="{ThemeResource PrimaryTextBrush}" Click="HamburgerButton_Click">
                            <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>